{
  "flywheel_version": "0.1.0",
  "project_name": "flywheel",
  "autonomy": 3,
  "improve_cadence_sessions": 5,
  "audit_cadence_sessions": 5,
  "tiers": {
    "architect": {
      "role": "last resort: twice-failed plans, irreversible forks, rule conflicts",
      "adapters": {
        "claude-code": {
          "model": "claude-fable-5",
          "level": "medium"
        },
        "codex": {
          "model": "gpt-5.5-pro",
          "level": "xhigh"
        },
        "opencode": {
          "provider": "anthropic",
          "model": "claude-fable-5"
        },
        "antigravity": {
          "model": "gemini-3.5-flash-latest",
          "level": "high"
        }
      }
    },
    "strategist": {
      "role": "plans, deep research, edge cases, requirement catalogs",
      "adapters": {
        "claude-code": {
          "model": "claude-opus-4-8",
          "level": "high"
        },
        "codex": {
          "model": "gpt-5.5",
          "level": "high"
        },
        "opencode": {
          "provider": "anthropic",
          "model": "claude-opus-4-8"
        },
        "antigravity": {
          "model": "gemini-3.5-flash-latest",
          "level": "high"
        }
      }
    },
    "engineer": {
      "role": "all production code, refactors, complex scripts",

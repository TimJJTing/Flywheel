          "model": "claude-sonnet-5",
          "level": "high"
        },
        "codex": {
          "model": "gpt-5.5",
          "level": "high"
        },
        "opencode": {
          "provider": "anthropic",
          "model": "claude-sonnet-5"
        },
        "antigravity": {
          "model": "gemini-3.5-flash-latest",
          "level": "high"
        }
      }
    },
    "utility": {
      "role": "batch reads/edits, searches, checklist checks",
      "adapters": {
        "claude-code": {
          "model": "claude-haiku-4-5-20251001",
